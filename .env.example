# Postgres connection string (any Postgres 15+ works: local, Supabase, Neon...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutri

# Anthropic API key, read by the Vercel AI SDK and the Anthropic SDK
ANTHROPIC_API_KEY=

# Shared household password for the login screen
AUTH_PASSWORD=

# HMAC key for session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: postal code used by the Mercadona scraper to pick a warehouse.
# Prices and availability vary by warehouse. Defaults to 28001 (Madrid).
MERCADONA_POSTAL_CODE=
